rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /games/{gameId} {
      allow read: if true;
      allow write: if false;
    }


    function isText(v, max) {
      return v is string && v.size() <= max;
    }

    function filled(v, max) {
      return isText(v, max) && v.trim().size() > 0;
    }

    function editableFields() {
      return ['displayName', 'bettingCap', 'consentedAt'].concat(detailFields());
    }

    function detailFields() {
      return ['firstName', 'lastName', 'middleName', 'birthdate', 'nationality', 'placeOfBirth',
        'email', 'occupation', 'sourceOfIncome', 'permanentAddress', 'currentAddress',
        'sameAsPermanent'];
    }

    function validBirthdate(b) {
      return b == '' || (
        b.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && int(b.split('-')[0]) >= 1900
        && timestamp.date(int(b.split('-')[0]) + 21, int(b.split('-')[1]), 1)
          + duration.value(int(b.split('-')[2]) - 1, 'd') <= request.time + duration.value(8, 'h')
      );
    }

    function validDetails(d) {
      return d.get('consentedAt', null) == request.time
        && filled(d.get('firstName', ''), 60)
        && filled(d.get('lastName', ''), 60)
        && isText(d.get('middleName', ''), 60)
        && filled(d.get('birthdate', ''), 10) && validBirthdate(d.get('birthdate', ''))
        && filled(d.get('nationality', ''), 60)
        && isText(d.get('placeOfBirth', ''), 60)
        && filled(d.get('email', ''), 254) && d.email.matches('^\\S+@\\S+[.]\\S+$')
        && filled(d.get('occupation', ''), 100)
        && d.get('sourceOfIncome', '') in ['Salary', 'Business', 'Savings', 'Investments',
          'Remittance', 'Pension', 'Allowance', 'Others']
        && filled(d.get('permanentAddress', ''), 250)
        && filled(d.get('currentAddress', ''), 250)
        && d.get('sameAsPermanent', false) is bool;
    }

    function validProfileWrite(d, keys) {
      return keys.hasOnly(editableFields())
        && (!keys.hasAny(['displayName']) || filled(d.displayName, 20))
        && (!keys.hasAny(['bettingCap']) || d.bettingCap == null
          || (d.bettingCap is number && d.bettingCap > 0 && d.bettingCap <= 10000000))
        && (!keys.hasAny(['consentedAt']) || d.consentedAt == request.time)
        && (!keys.hasAny(detailFields()) || validDetails(d));
    }

    function keepsIfSet(field) {
      return !(field in resource.data) || resource.data[field] == ''
        || request.resource.data.get(field, null) == resource.data[field];
    }

    function keepsIdentity() {
      return keepsIfSet('firstName') && keepsIfSet('middleName') && keepsIfSet('lastName')
        && keepsIfSet('birthdate') && keepsIfSet('nationality');
    }


    function maxBalance() {
      return 9999999999.99;
    }

    function depositWindow() {
      return duration.value(10, 'm');
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function txPath(uid, txId) {
      return /databases/$(database)/documents/users/$(uid)/transactions/$(txId);
    }

    function phDay(t) {
      return (t + duration.value(8, 'h')).date();
    }

    function bonusUsedToday(user) {
      return user.get('lastReloadBonusAt', null) != null
        && phDay(user.lastReloadBonusAt) == phDay(request.time);
    }

    function depositOpenAfter(uid, txId) {
      return txId != null && existsAfter(txPath(uid, txId))
        && getAfter(txPath(uid, txId)).data.status == 'pending'
        && request.time < getAfter(txPath(uid, txId)).data.createdAt + depositWindow();
    }

    function opensDeposit(uid) {
      let newId = request.resource.data.get('pendingDepositId', null);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingDepositId'])
        && newId is string
        && !depositOpenAfter(uid, resource.data.get('pendingDepositId', null))
        && !exists(txPath(uid, newId))
        && existsAfter(txPath(uid, newId))
        && resource.data.get('verifiedAt', null) != null;
    }

    function clearsPending(uid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingDepositId'])
        && request.resource.data.pendingDepositId == null
        && !depositOpenAfter(uid, resource.data.get('pendingDepositId', null));
    }

    function claimsDeposit(uid) {
      let d = request.resource.data;
      let old = resource.data;
      let keys = d.diff(old).affectedKeys();
      let id = d.get('claimedDepositId', '');
      let before = get(txPath(uid, id)).data;
      let after = getAfter(txPath(uid, id)).data;
      let bonus = float(after.creditedBonus);
      let amount = float(before.amount);
      let oldRemaining = float(old.get('turnoverRemaining', 0));
      let added = amount * 1.0 + bonus * 10.0;
      return keys.hasOnly(['balance', 'totalDeposit', 'turnoverRequired', 'turnoverRemaining',
          'lastReloadBonusAt', 'pendingDepositId', 'claimedDepositId'])
        && before.type == 'deposit'
        && before.status in ['pending', 'expired']
        && before.get('approvedAt', null) != null
        && after.status == 'successful'
        && d.balance == float(old.get('balance', 0)) + amount + bonus
        && d.balance <= maxBalance()
        && d.totalDeposit == float(old.get('totalDeposit', 0)) + amount
        && d.turnoverRemaining == (oldRemaining > 0 ? oldRemaining : 0.0) + added
        && d.turnoverRequired
          == (oldRemaining > 0 ? float(old.get('turnoverRequired', 0)) : 0.0) + added
        && (bonus > 0 ? d.lastReloadBonusAt == request.time : !keys.hasAny(['lastReloadBonusAt']))
        && (old.get('pendingDepositId', null) == id
          ? d.pendingDepositId == null
          : !keys.hasAny(['pendingDepositId']));
    }

    function opensNewDeposit(uid, txId) {
      let d = request.resource.data;
      let user = get(userPath(uid)).data;
      let amount = float(d.get('amount', 0));
      let fields = ['type', 'status', 'amount', 'bonus', 'method', 'createdAt'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && d.type == 'deposit'
        && d.status == 'pending'
        && d.amount is number
        && amount >= 20 && amount <= 50000
        && math.abs(amount * 100.0 - float(math.round(amount * 100.0))) < 0.000001
        && d.method in ['GCash', 'Maya']
        && d.createdAt == request.time
        && user.get('verifiedAt', null) != null
        && getAfter(userPath(uid)).data.get('pendingDepositId', null) == txId
        && d.bonus is number
        && (d.bonus == 0
          || (float(d.bonus) == float(math.round(amount * 30.0)) / 100.0 && !bonusUsedToday(user)))
        && float(user.get('balance', 0)) + amount + float(d.bonus) <= maxBalance();
    }

    function recordsBonus(uid, txId) {
      let d = request.resource.data;
      let depositId = txId.replace('_bonus$', '');
      let fields = ['type', 'status', 'amount', 'method', 'createdAt'];
      return txId.matches('^.+_bonus$')
        && d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && d.type == 'bonus'
        && d.status == 'successful'
        && d.method == 'Reload Bonus'
        && d.createdAt == request.time
        && get(txPath(uid, depositId)).data.status in ['pending', 'expired']
        && getAfter(txPath(uid, depositId)).data.status == 'successful'
        && d.amount > 0
        && d.amount == getAfter(txPath(uid, depositId)).data.creditedBonus;
    }

    function addsProof() {
      let d = request.resource.data;
      let old = resource.data;
      return old.type == 'deposit'
        && old.status == 'pending'
        && request.time < old.createdAt + depositWindow()
        && d.diff(old).affectedKeys()
          .hasOnly(['sentAmount', 'reference', 'submittedAt', 'approvedAt'])
        && d.sentAmount == old.amount
        && d.reference is string
        && d.reference.matches('^[A-Za-z0-9]{8,16}$')
        && d.submittedAt == request.time
        && d.approvedAt == request.time;
    }

    function closesClaimed(uid, txId) {
      let d = request.resource.data;
      let old = resource.data;
      return old.type == 'deposit'
        && old.status in ['pending', 'expired']
        && old.get('approvedAt', null) != null
        && d.diff(old).affectedKeys().hasOnly(['status', 'creditedBonus'])
        && d.status == 'successful'
        && d.creditedBonus == (bonusUsedToday(get(userPath(uid)).data) ? 0 : old.get('bonus', 0))
        && getAfter(userPath(uid)).data.get('claimedDepositId', null) == txId;
    }

    function closesExpired() {
      let d = request.resource.data;
      let old = resource.data;
      return old.type == 'deposit'
        && old.status == 'pending'
        && old.get('approvedAt', null) == null
        && old.get('rejectedAt', null) == null
        && request.time >= old.createdAt + depositWindow()
        && d.diff(old).affectedKeys().hasOnly(['status'])
        && d.status == 'expired';
    }

    function closesRejected() {
      let d = request.resource.data;
      let old = resource.data;
      return old.type == 'deposit'
        && old.status in ['pending', 'expired']
        && old.get('rejectedAt', null) != null
        && d.diff(old).affectedKeys().hasOnly(['status'])
        && d.status == 'failed';
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && validProfileWrite(request.resource.data, request.resource.data.keys());
      allow update: if isOwner(uid) && (
        (validProfileWrite(request.resource.data,
          request.resource.data.diff(resource.data).affectedKeys()) && keepsIdentity())
        || opensDeposit(uid)
        || clearsPending(uid)
        || claimsDeposit(uid));
      allow delete: if false;

      match /favorites/{gameId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && gameId.matches('^[a-z0-9-]{1,80}$')
          && request.resource.data.keys().hasOnly(['addedAt'])
          && request.resource.data.addedAt == request.time;
        allow update: if false;
      }

      match /transactions/{txId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && (opensNewDeposit(uid, txId) || recordsBonus(uid, txId));
        allow update: if isOwner(uid)
          && (addsProof() || closesClaimed(uid, txId) || closesRejected() || closesExpired());
        allow delete: if false;
      }
    }
  }
}
